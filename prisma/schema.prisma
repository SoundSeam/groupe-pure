generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CmsRevisionState {
  DRAFT
  PUBLISHED
}

model CmsPage {
  id                  String          @id @default(cuid())
  path                String          @unique
  locale              String
  draftContent        Json            @default("{}")
  publishedContent    Json            @default("{}")
  revision            Int             @default(0)
  publishedRevision   Int             @default(0)
  isVisible           Boolean?
  visibilityUpdatedBy String?
  updatedBy           String?
  publishedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  revisions           CmsRevision[]
  assets              CmsAsset[]
  assetUsages         CmsAssetUsage[]

  @@index([locale])
}

model CmsRevision {
  id        String           @id @default(cuid())
  pageId    String
  revision  Int
  state     CmsRevisionState
  content   Json
  authorId  String
  createdAt DateTime         @default(now())
  page      CmsPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, revision])
  @@index([pageId, state, createdAt])
}

model CmsAsset {
  id               String          @id @default(cuid())
  pageId           String?
  fieldKey         String
  fileName         String
  storagePath      String          @unique
  publicUrl        String
  mimeType         String
  size             Int
  uploadedBy       String
  lastReferencedAt DateTime?
  retainedUntil    DateTime?
  createdAt        DateTime        @default(now())
  page             CmsPage?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  usages           CmsAssetUsage[]

  @@index([pageId, fieldKey, createdAt])
  @@index([createdAt])
  @@index([retainedUntil])
}

model CmsAssetUsage {
  id          String   @id @default(cuid())
  assetId     String
  pageId      String
  fieldKey    String
  inDraft     Boolean  @default(false)
  inPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  asset       CmsAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([assetId, pageId, fieldKey])
  @@index([pageId, fieldKey])
  @@index([assetId, inDraft, inPublished])
}

// These tables are owned by the Supabase migration chain. They remain in this
// schema so Prisma can introspect them, while `tables.external` prevents Prisma
// Migrate from creating, altering, or dropping them.
model contact_rate_limits {
  scope          String
  key_hash       String
  window_start   DateTime @db.Timestamptz(6)
  window_seconds Int
  request_count  Int      @default(1)
  expires_at     DateTime @db.Timestamptz(6)

  @@id([scope, key_hash, window_start])
  @@index([expires_at], map: "contact_rate_limits_expiry_idx")
}

model contact_submissions {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotency_key  String    @unique @db.Uuid
  locale           String
  name             String
  visitor_email    String
  phone            String?
  project_type     String
  subcategory      String
  budget_range     String
  message          String
  attachment_name  String?
  attachment_type  String?
  attachment_size  Int?
  storage_path     String?   @unique
  ip_hash          String
  user_agent       String?
  status           String    @default("PENDING")
  resend_email_id  String?
  error_code       String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  sent_at          DateTime? @db.Timestamptz(6)
  decision         String    @default("ACCEPTED")
  decision_reasons String[]  @default([])
  risk_score       Int       @default(0) @db.SmallInt
  turnstile_status String    @default("NOT_CONFIGURED")
  email_hash       String?
  content_hash     String?

  @@index([decision, created_at(sort: Desc)], map: "contact_submissions_decision_created_idx")
  @@index([ip_hash, created_at(sort: Desc)], map: "contact_submissions_ip_created_idx")
  @@index([status, created_at(sort: Desc)], map: "contact_submissions_status_created_idx")
}
